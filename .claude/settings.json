    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(del /s /q *)",
      "Bash(format *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}